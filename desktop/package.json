{
  "name": "tennis-vision-studio",
  "productName": "Tennis Vision Studio",
  "version": "0.6.1",
  "description": "Estúdio local de análise de tênis e câmeras de alta velocidade",
  "author": "Tennis Vision",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "node build-installer.cjs",
    "pack": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "http-proxy": "1.18.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.tennisvision.studio",
    "productName": "Tennis Vision Studio",
    "publish": { "provider": "github", "owner": "Laikan2", "repo": "tennis-vision-releases", "releaseType": "release" },
    "directories": {
      "output": "releases",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "server.cjs",
      "preload.cjs",
      "startup.html",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "ui"
      },
      {
        "from": "build/engine/TennisVisionEngine",
        "to": "engine"
      },
      {
        "from": "../tools/mediamtx",
        "to": "receiver",
        "filter": [
          "mediamtx.exe",
          "mediamtx.yml",
          "LICENSE"
        ]
      },
      {
        "from": "build/models",
        "to": "models"
      },
      {
        "from": "setup",
        "to": "setup"
      },
      {
        "from": "../mobile/releases",
        "to": "android",
        "filter": [
          "*v0.5.2.apk"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "artifactName": "Tennis-Vision-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tennis Vision Studio",
      "deleteAppDataOnUninstall": false
    }
  }
}
