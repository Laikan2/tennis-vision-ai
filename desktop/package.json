{
  "name": "tennis-vision-studio",
  "productName": "Tennis Vision Studio",
  "version": "0.6.11",
  "description": "Estúdio local de análise de tênis e câmeras de alta velocidade",
  "author": "Tennis Vision",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "node build-installer.cjs",
    "pack": "node verify-ui.cjs && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "http-proxy": "1.18.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.tennisvision.studio",
    "productName": "Tennis Vision Studio",
    "publish": {
      "provider": "github",
      "owner": "Laikan2",
      "repo": "tennis-vision-releases",
      "releaseType": "release"
    },
    "directories": {
      "output": "releases",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "server.cjs",
      "preload.cjs",
      "startup.html",
      "assets/icon.png",
      "package.json",
      "mobile-panel.cjs"
    ],
    "extraResources": [
      {
        "from": "../release-assets/licenses",
        "to": "licenses"
      },
      {
        "from": "../frontend/out",
        "to": "ui"
      },
      {
        "from": "build/engine/TennisVisionEngine",
        "to": "engine"
      },
      {
        "from": "../tools/mediamtx",
        "to": "receiver",
        "filter": [
          "mediamtx.exe",
          "mediamtx.yml",
          "LICENSE"
        ]
      },
      {
        "from": "build/models",
        "to": "models"
      },
      {
        "from": "setup",
        "to": "setup"
      },
      {
        "from": "build/ios",
        "to": "ios",
        "filter": [
          "Tennis-Vision-Camera-iOS-v0.6.6-Projeto.zip",
          "Tennis-Vision-Camera-iOS-v0.6.6-AltStore.ipa"
        ]
      },
      {
        "from": "../mobile/releases",
        "to": "android",
        "filter": [
          "*v0.6.6.apk"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "artifactName": "Tennis-Vision-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tennis Vision Studio",
      "deleteAppDataOnUninstall": false
    }
  }
}
