<?xml version="1.0" encoding="utf-8"?>
<resources>
 <style name="Theme.TennisVisionCamera" parent="Theme.AppCompat.DayNight.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:navigationBarColor">@color/tv_background</item><item name="android:statusBarColor">@color/tv_background</item>
  <item name="android:windowBackground">@color/tv_background</item><item name="colorAccent">@color/tv_accent</item><item name="android:windowNoTitle">true</item>
 </style>
 <style name="CameraBody"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/tv_muted</item><item name="android:textSize">13sp</item><item name="android:lineSpacingExtra">3dp</item></style>
 <style name="CameraLabel" parent="CameraBody"><item name="android:layout_marginTop">12dp</item><item name="android:textColor">@color/tv_text</item><item name="android:fontFamily">sans-serif-medium</item></style>
 <style name="CameraEyebrow" parent="CameraBody"><item name="android:textColor">@color/tv_accent</item><item name="android:textSize">10sp</item><item name="android:letterSpacing">.1</item><item name="android:textStyle">bold</item></style>
 <style name="CameraInput"><item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item><item name="android:layout_marginTop">6dp</item><item name="android:background">@drawable/input_background</item><item name="android:paddingHorizontal">12dp</item><item name="android:textColor">@color/tv_text</item><item name="android:textColorHint">@color/tv_muted</item><item name="android:singleLine">true</item><item name="android:selectAllOnFocus">true</item><item name="android:importantForAutofill">no</item><item name="android:textSize">14sp</item></style>
 <style name="CameraSpinner"><item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item><item name="android:layout_marginTop">6dp</item><item name="android:background">@drawable/input_background</item><item name="android:popupBackground">@color/tv_panel</item></style>
 <style name="CameraCheck"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item><item name="android:textColor">@color/tv_text</item><item name="android:buttonTint">@color/tv_accent</item><item name="android:textSize">13sp</item></style>
 <style name="CameraTab"><item name="android:layout_width">0dp</item><item name="android:layout_height">48dp</item><item name="android:layout_weight">1</item><item name="android:minWidth">0dp</item><item name="android:background">@drawable/tab_background</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/tv_text</item><item name="android:textSize">12sp</item><item name="android:textAllCaps">false</item><item name="android:padding">0dp</item><item name="android:fontFamily">sans-serif-medium</item></style>
 <style name="CameraPrimary"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:minHeight">48dp</item><item name="android:minWidth">48dp</item><item name="android:background">@drawable/button_primary</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/tv_background</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:paddingHorizontal">12dp</item></style>
 <style name="CameraSecondary" parent="CameraPrimary"><item name="android:layout_height">48dp</item><item name="android:background">@drawable/button_secondary</item><item name="android:textColor">@color/tv_text</item><item name="android:textSize">12sp</item></style>
 <style name="TelemetryColumn"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:paddingEnd">12dp</item><item name="android:minWidth">64dp</item></style>
 <style name="TelemetryLabel"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/tv_muted</item><item name="android:textSize">10sp</item><item name="android:letterSpacing">.06</item></style>
 <style name="TelemetryValue"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">4dp</item><item name="android:textColor">@color/tv_text</item><item name="android:textSize">16sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
</resources>
