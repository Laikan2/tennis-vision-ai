<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/localRoot" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@color/tv_background" android:padding="12dp">
 <LinearLayout android:id="@+id/localHeader" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_launcher" android:contentDescription="Tennis Vision" />
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="TENNIS VISION  /  LOCAL" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="14sp" android:letterSpacing=".08" />
  <Button android:id="@+id/localHistory" style="@style/CameraSecondary" android:layout_width="100dp" android:text="Histórico" />
  <Button android:id="@+id/networkTab" style="@style/CameraSecondary" android:layout_width="100dp" android:layout_marginStart="8dp" android:text="Ajustes" />
 </LinearLayout>
 <LinearLayout android:id="@+id/localBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="8dp">
  <ai.tennisvision.camera.LocalVideoPanel android:id="@+id/localVideoPanel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_background">
   <TextView android:id="@+id/localStatus" android:lines="2" android:ellipsize="end" style="@style/CameraLabel" android:text="Permita a câmera para começar" android:textSize="16sp" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:accessibilityLiveRegion="polite" />
   <TextView android:id="@+id/localSurface" style="@style/CameraLabel" android:paddingHorizontal="12dp" android:layout_marginTop="4dp" android:text="CHÃO · QUICADAS" android:textSize="12sp" android:textColor="@color/tv_accent" android:accessibilityLiveRegion="polite" />
   <ai.tennisvision.camera.LocalCourtView android:id="@+id/localVideo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
   <LinearLayout android:id="@+id/localEditor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
    <TextView android:id="@+id/localEditorHint" style="@style/CameraBody" android:textSize="12sp" />
    <Button android:id="@+id/localWholeFloor" style="@style/CameraSecondary" android:text="Toda a imagem é piso · salvar" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
     <Button android:id="@+id/localSaveArea" style="@style/CameraPrimary" android:layout_width="0dp" android:layout_weight="1" android:text="Salvar área" />
     <Button android:id="@+id/localRedraw" style="@style/CameraSecondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Recomeçar" />
     <Button android:id="@+id/localCancelArea" style="@style/CameraSecondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Cancelar" />
    </LinearLayout>
   </LinearLayout>
  </ai.tennisvision.camera.LocalVideoPanel>
  <ScrollView android:id="@+id/settingsScroll" android:layout_width="286dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:fillViewport="true">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
    <TextView style="@style/CameraEyebrow" android:text="SEU TREINO, NO CELULAR" />
    <Button android:id="@+id/localStart" style="@style/CameraPrimary" android:layout_marginTop="12dp" android:text="Permitir câmera" />
   <Button android:id="@+id/localFinish" style="@style/CameraSecondary" android:layout_marginTop="6dp" android:text="Encerrar treino · limpar marcas" />
     <Button android:id="@+id/localConfirmArea" style="@style/CameraSecondary" android:text="Área coincide · habilitar IN/OUT" android:visibility="gone" />
    <TextView style="@style/CameraBody" android:textSize="11sp" android:layout_marginTop="6dp" android:text="O contorno procura a bola na prévia. Iniciar treino ativa a contagem de impactos." />
    <Button android:id="@+id/localFraming" style="@style/CameraSecondary" android:layout_marginTop="8dp" android:text="Enquadramento e detalhe" />
    <Button android:id="@+id/localCourt" style="@style/CameraSecondary" android:layout_marginTop="6dp" android:text="Marcar quadra · 4 cantos" />
    <TextView android:id="@+id/localAreaSummary" style="@style/CameraBody" android:textSize="11sp" android:layout_marginTop="6dp" android:text="Quadra inteira ou meia quadra. Se os dois lados não couberem, ajuste a posição ou a lente." />
    <TextView style="@style/CameraEyebrow" android:layout_marginTop="14dp" android:text="TESTE EM CASA" />
    <Button android:id="@+id/localArea" style="@style/CameraSecondary" android:layout_marginTop="6dp" android:text="Marcar chão" />
    <Button android:id="@+id/localWall" style="@style/CameraSecondary" android:layout_marginTop="6dp" android:text="Marcar parede" />
    <TextView style="@style/CameraBody" android:textSize="11sp" android:layout_marginTop="6dp" android:text="Chão: área e limite do piso, em dois passos. Parede: área de contato. As marcações são temporárias: nova sessão ou fechar o app limpa as áreas." />
    <Button android:id="@+id/localFloor" style="@style/CameraSecondary" android:layout_marginTop="6dp" android:text="Ajustar limite parede/chão" />
    <TextView android:id="@+id/localDecision" style="@style/CameraLabel" android:text="Aguardando contato" android:textSize="22sp" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/localStats" style="@style/CameraBody" android:layout_marginTop="6dp" android:text="0 IN · 0 OUT · 0 para revisar" />
   <TextView android:id="@+id/localMetrics" style="@style/CameraBody" android:paddingHorizontal="12dp" android:layout_marginTop="4dp" android:text="Processamento local · sem computador" android:textSize="11sp" />
    <Button android:id="@+id/localReview" style="@style/CameraSecondary" android:layout_marginTop="8dp" android:text="Revisar último contato" />
    <TextView style="@style/CameraBody" android:layout_marginTop="8dp" android:text="IN toca ou fica dentro da linha. OUT fica fora. Perto da linha, revise. Velocidade lateral estimada pelo tamanho da bola de 67 mm." android:textSize="11sp" />
    <LinearLayout android:id="@+id/updateSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
     <TextView android:id="@+id/versionText" style="@style/CameraEyebrow" android:text="ANDROID" android:minHeight="32dp" />
     <TextView android:id="@+id/updateStatus" style="@style/CameraBody" android:textSize="11sp" />
     <ProgressBar android:id="@+id/updateProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:visibility="gone" />
     <Button android:id="@+id/checkUpdates" style="@style/CameraSecondary" android:text="Buscar atualização" />
     <Button android:id="@+id/installUpdate" style="@style/CameraSecondary" android:text="Instalar atualização" android:visibility="gone" />
    </LinearLayout>
   </LinearLayout>
  </ScrollView>
 </LinearLayout>
</LinearLayout>
