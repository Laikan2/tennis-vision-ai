<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@color/tv_background">
  <com.journeyapps.barcodescanner.DecoratedBarcodeView
    android:id="@+id/pairingBarcodeView" android:layout_width="match_parent"
    android:layout_height="match_parent" android:layout_margin="24dp" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="top|start" android:layout_margin="32dp"
    android:background="@drawable/overlay_background" android:padding="12dp"
    android:text="@string/scanner_title" android:textColor="@color/tv_text"
    android:textSize="18sp" android:fontFamily="sans-serif-medium" />
  <Button android:id="@+id/cancelScan" style="@style/CameraSecondary"
    android:layout_width="wrap_content" android:layout_gravity="top|end"
    android:layout_margin="32dp" android:text="@string/cancel_scan" />
</FrameLayout>
