# Run on loopback. Do not expose this local MVP directly to the internet.
TV_DATA_DIR=./data
# Optional override used by the mobile-camera QR code when Windows has multiple networks.
TV_LAN_IP=
# Optional, only after Apple-signed distribution exists.
TV_IOS_TESTFLIGHT_URL=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TV_SECRET_KEY=
# Optional: env-only initial camera; credentials never returned to browser.
TV_CAMERA_HOST=
TV_CAMERA_USER=
TV_CAMERA_PASSWORD=
TV_CAMERA_PORT=554
TV_CAMERA_PATH=/Streaming/Channels/101
# Optional specialized Ultralytics model. Install backend/requirements-ml.txt first.
TV_MODEL_PATH=
TV_MODEL_CLASS=0
# Optional explicit class IDs when the model has multiple classes.
TV_BALL_CLASS=
TV_PERSON_CLASS=0
TV_PERSON_CONF=.6
TV_DEVICE=auto
# General YOLO identifies people periodically; the lightweight ball detector
# still runs on every analysed frame.
TV_MODEL_INTERVAL=30
TV_MODEL_CONF=.24
TV_ANALYSIS_MAX_WIDTH=640
# Pace only the fallback JPEG display; camera capture and WebRTC stay independent.
TV_PREVIEW_MAX_FPS=60
# tcp is safer; udp can reduce latency on a reliable local network.
TV_RTSP_TRANSPORT=tcp
# Advanced override, normally leave empty.
TV_FFMPEG_CAPTURE_OPTIONS=
